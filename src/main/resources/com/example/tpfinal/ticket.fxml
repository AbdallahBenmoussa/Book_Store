<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="450.0" stylesheets="@style/Ticket.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tpfinal.Controller.TicketController">

    <VBox alignment="CENTER" spacing="20" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

        <Label style="-fx-text-fill: #2e7d32; -fx-font-weight: bold; -fx-font-size: 18px;" text="✓ Sale Recorded Successfully!" />

        <VBox prefHeight="200.0" prefWidth="400.0" spacing="12" style="-fx-padding: 20; -fx-border-color: #ddd; -fx-border-width: 2; -fx-border-radius: 5; -fx-background-color: #f9f9f9;">
            <HBox spacing="10">
                <Label style="-fx-font-weight: bold; -fx-min-width: 100;" text="Book:" />
                <Label fx:id="bookTitleLabel" style="-fx-font-size: 14px;" text="-" />
            </HBox>
            <HBox spacing="10">
                <Label style="-fx-font-weight: bold; -fx-min-width: 100;" text="Unit Price:" />
                <Label fx:id="UnitPriceLable" text="0.00" />
            </HBox>
            <HBox spacing="10">
                <Label style="-fx-font-weight: bold; -fx-min-width: 100;" text="Quantity:" />
                <Label fx:id="QuantityLable" text="0" />
            </HBox>
            <HBox spacing="10" style="-fx-padding: 10 0 0 0; -fx-border-color: #ccc; -fx-border-width: 1 0 0 0;">
                <Label style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-min-width: 100; -fx-text-fill: #1976d2;" text="Total:" />
                <Label fx:id="TotalPriceLable" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #1976d2;" text="0.00" />
            </HBox>
        </VBox>

        <HBox alignment="CENTER" spacing="15">
            <Button fx:id="doneBtn" onAction="#handleDone" prefWidth="120" style="-fx-background-color: #4caf50; -fx-text-fill: white;" text="Done" />
        </HBox>

    </VBox>

</AnchorPane>
