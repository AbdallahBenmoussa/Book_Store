<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" prefHeight="600" prefWidth="800" stylesheets="@style/BrowsBooks.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tpfinal.Controller.BrowsBooksController">

    <Label layoutX="20" layoutY="20" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Browse Books" />

    <TableView fx:id="booksTable" layoutX="49.0" layoutY="65.0" prefHeight="450" prefWidth="722.0">
        <columns>
            <TableColumn fx:id="titleColumn" prefWidth="200" text="Title" />
            <TableColumn fx:id="authorColumn" prefWidth="150" text="Author" />
            <TableColumn fx:id="yearColumn" prefWidth="131.20001220703125" text="Quantity" />
            <TableColumn fx:id="priceColumn" prefWidth="118.39999389648438" text="Price" />
         <TableColumn fx:id="priceColumn1" prefWidth="120.80002441406248" text="Aaction" />
        </columns>
    </TableView>
    <Button fx:id="buyBtn" layoutX="75.0" layoutY="540.0" prefWidth="120" text="Buy" />

    <TextField fx:id="searchField" layoutX="436.0" layoutY="542.0" prefWidth="200" promptText="Search by title or author" />
    <Button fx:id="searchBtn" layoutX="655.0" layoutY="539.0" prefHeight="34.0" prefWidth="109.0" text="Search" />

</AnchorPane>
