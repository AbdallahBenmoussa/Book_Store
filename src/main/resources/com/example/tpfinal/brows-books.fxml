<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane id="AnchorPane" prefHeight="600" prefWidth="800" stylesheets="@style/BrowsBooks.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tpfinal.Controller.BrowsBooksController">

    <Button fx:id="backBtn" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#goBack" prefHeight="32.0" prefWidth="69.0" text="←">
      <font>
         <Font name="Arial Unicode MS" size="34.0" />
      </font></Button>
    <Label layoutX="94" layoutY="20" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Manage Sales" />

    <TableView fx:id="booksTable" layoutX="49.0" layoutY="65.0" prefHeight="450" prefWidth="722.0">
        <columns>
            <TableColumn fx:id="titleColumn" prefWidth="200" text="Title" />
            <TableColumn fx:id="authorColumn" prefWidth="150" text="Author" />
            <TableColumn fx:id="yearColumn" prefWidth="131.20001220703125" text="Quantity" />
            <TableColumn fx:id="priceColumn" prefWidth="118.39999389648438" text="Price" />
        </columns>
    </TableView>
    <Label layoutX="10.0" layoutY="521.0" text="Book" />
    <ComboBox fx:id="bookCombo" layoutX="90.0" layoutY="525.0" prefWidth="200.0" />

    <Label layoutX="485.0" layoutY="521.0" text="Quantity sold" />
    <TextField fx:id="quantitySoldField" layoutX="691.0" layoutY="523.0" prefWidth="80" promptText="Qty" />
    <Label layoutX="14.0" layoutY="583.0" text="Total:" />
    <Label fx:id="totalLabel" layoutX="104.0" layoutY="583.0" style="-fx-font-weight: bold; -fx-text-fill: #2e7d32;" text="0.00" />
    <Button fx:id="recordSaleBtn" layoutX="636.0" layoutY="583.0" onAction="#recordSale" prefHeight="32.0" prefWidth="134.0" text="Record sale" />

    <TextField fx:id="searchField" layoutX="436.0" layoutY="18.0" prefWidth="200" promptText="Search by title or author" />
    <Button fx:id="searchBtn" layoutX="655.0" layoutY="15.0" onAction="#searchBooks" prefHeight="34.0" prefWidth="109.0" text="Search" />

</AnchorPane>
