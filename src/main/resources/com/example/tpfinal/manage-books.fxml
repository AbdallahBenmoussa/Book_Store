<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="600" prefWidth="800" stylesheets="@style/ManageBooks.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tpfinal.Controller.ManageBooksController">

    <Button fx:id="backBtn" layoutX="2.0" layoutY="2.0" mnemonicParsing="false" onAction="#goBack" prefHeight="32.0" prefWidth="65.0" text="← " />
    <Label layoutX="318.0" layoutY="15.0" style="-fx-font-size: 24px; -fx-font-weight: normal;" text="Manage Books" />

    <TableView fx:id="booksTable" layoutX="49.0" layoutY="50.0" prefHeight="280" prefWidth="702.0">
        <columns>
            <TableColumn fx:id="titleColumn" prefWidth="175.0" text="Title" />
            <TableColumn fx:id="authorColumn" prefWidth="175.0" text="Author" />
            <TableColumn fx:id="priceColumn" prefWidth="175.0" text="Price" />
            <TableColumn fx:id="yearColumn" prefWidth="177.0" text="Quantity" />
        </columns>
    </TableView>

    <VBox layoutX="49.0" layoutY="340.0" spacing="10">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-weight: normal;" text="Search:" />
            <TextField fx:id="searchField" prefWidth="200" promptText="Search by title or author" />
            <Button fx:id="searchBtn" onAction="#searchBooks" prefHeight="34.0" prefWidth="109.0" text="Search" />
        </HBox>
    </VBox>

    <VBox layoutX="444.0" layoutY="340.0" spacing="8">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label minWidth="70.0" style="-fx-font-weight: normal;" text="Title:" />
            <TextField fx:id="titleField" prefWidth="200" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label minWidth="70.0" style="-fx-font-weight: normal;" text="Author:" />
            <TextField fx:id="authorField" prefWidth="200" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label minWidth="70.0" style="-fx-font-weight: normal;" text="Price:" />
            <TextField fx:id="priceField" prefWidth="200" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label minWidth="70.0" style="-fx-font-weight: normal;" text="Quantity:" />
            <TextField fx:id="quantityField" prefWidth="200" />
        </HBox>
    </VBox>

    <HBox layoutX="75.0" layoutY="540.0" spacing="15">
        <Button fx:id="addBtn" onAction="#addBook" prefWidth="120" text="Add" />
        <Button fx:id="editBtn" onAction="#editBook" prefWidth="120" text="Edit" />
        <Button fx:id="deleteBtn" onAction="#deleteBook" prefWidth="120" text="Delete" />
    </HBox>

</AnchorPane>
