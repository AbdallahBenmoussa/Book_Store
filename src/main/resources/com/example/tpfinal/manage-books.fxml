<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" prefHeight="600" prefWidth="800" stylesheets="@style/ManageBooks.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tpfinal.Controller.ManageBooksController">

    <Button fx:id="backBtn" layoutX="2.0" layoutY="-1.0" mnemonicParsing="false" onAction="#goBack" prefHeight="32.0" prefWidth="65.0" text="← " />
    <Label layoutX="318.0" layoutY="15.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Manage Books" />

    <TableView fx:id="booksTable" layoutX="49.0" layoutY="65.0" prefHeight="450" prefWidth="722.0">
        <columns>
            <TableColumn fx:id="titleColumn" prefWidth="168.80005264282227" text="Title" />
            <TableColumn fx:id="authorColumn" prefWidth="152.0000457763672" text="Author" />
            <TableColumn fx:id="priceColumn" prefWidth="122.39996337890625" text="Price" />
            <TableColumn fx:id="yearColumn" prefWidth="113.60003662109375" text="Quantity" />
         <TableColumn fx:id="priceColumn1" prefWidth="164.0" text="Action" />
        </columns>
    </TableView>
    <Button fx:id="addBtn" layoutX="75.0" layoutY="540.0" prefWidth="120" text="ADD" />

    <TextField fx:id="searchField" layoutX="436.0" layoutY="542.0" prefWidth="200" promptText="Search by title or author" />
    <Button fx:id="searchBtn" layoutX="655.0" layoutY="539.0" onAction="#searchBooks" prefHeight="34.0" prefWidth="109.0" text="Search" />

</AnchorPane>
